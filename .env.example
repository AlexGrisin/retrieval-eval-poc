# Copy this file to .env and replace the empty key. The .env file is ignored by Git.

# Real deployed-skill target. These are machine-local paths, so set them in .env
# instead of committing a workspace layout. CLI options take precedence.
EVAL_PLUGIN_DIR=/path/to/plugins/sdp-context
EVAL_MCP_CONFIG=/path/to/plugins/sdp-context/.mcp.json

# Private values for public case aliases. These are required only by cases that use
# the corresponding Example… identifier; do not commit their real values.
EVAL_ALIAS_EXAMPLE_ORGANIZATION=
EVAL_ALIAS_EXAMPLE_PORTAL_REPOSITORY=
EVAL_ALIAS_EXAMPLE_FEATURE=

# Optional semantic judge. Normal deterministic runs do not require these values.
LLM_GATEWAY_URL=https://api.openai.com/v1
LLM_GATEWAY_TOKEN=
LLM_JUDGE_MODEL=gpt-4o-mini-2024-07-18
LLM_JUDGE_MODEL_VERSION=2024-07-18
