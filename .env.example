# Copy this file to .env and replace the empty key. The .env file is ignored by Git.

# MCP streamable-HTTP URL of the knowledge server. Falls back to this default when
# unset: http://127.0.0.1:8000/mcp. See harness/runner.py::resolve_server_url.
KS_SERVER_URL=http://127.0.0.1:8000/mcp

LLM_GATEWAY_URL=https://api.openai.com/v1
LLM_GATEWAY_TOKEN=
LLM_JUDGE_MODEL=gpt-4o-mini-2024-07-18
LLM_JUDGE_MODEL_VERSION=2024-07-18
